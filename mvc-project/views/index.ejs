<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
  </head>
  <body>
    <form action="/add" method="POST">
      <input
        type="text"
        name="taskText"
        placeholder="Enter your task here..."
        required
      />
      <button type="submit">Add Task</button>
    </form>
    <ul>
        <% if(tasks.length > 0){ %>
           <%  tasks.forEach(task =>{ %>
<li>
    <%= task.text %>
</li>
          <%  })  %>
       <% } %>
    </ul>
  </body>
</html>
